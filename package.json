{
  "name": "valida-es",
  "version": "1.0.0",
  "description": "Validación, formato y generación de identificadores españoles: DNI, NIE, CIF, NIF, IBAN, CCC, NSS, teléfonos, códigos postales y matrículas. Sin dependencias.",
  "keywords": [
    "dni",
    "nie",
    "cif",
    "nif",
    "iban",
    "ccc",
    "nss",
    "seguridad-social",
    "españa",
    "spain",
    "validation",
    "validator",
    "telefono",
    "codigo-postal",
    "matricula"
  ],
  "license": "MIT",
  "author": "Hodei Medina <hodeione41@gmail.com> (https://h-com-bay.vercel.app)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hodeione/valida-es.git"
  },
  "homepage": "https://hodeione.github.io/valida-es/",
  "bugs": "https://github.com/hodeione/valida-es/issues",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "test:cov": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run typecheck && npm test && npm run build",
    "demo": "vite --config demo/vite.config.ts",
    "demo:build": "vite build --config demo/vite.config.ts"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^5.0.3",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "vite": "^8.3.4",
    "vitest": "^5.0.3"
  }
}
